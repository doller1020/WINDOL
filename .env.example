# ============================================================
# VARIÁVEIS DE AMBIENTE — Sistema Windol (TCC UPIS)
# ============================================================
# INSTRUÇÃO: Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo ".env" real no repositório.
# ============================================================

# Chave secreta da aplicação Flask (OBRIGATÓRIA)
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
WINDOL_SECRET_KEY=substitua-por-uma-chave-segura-gerada-aleatoriamente

# Porta da aplicação (opcional, padrão: 5000)
PORT=5000
